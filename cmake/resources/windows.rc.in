#include <winver.h>

IDI_ICON1   ICON    "@RES_DIR@/icon.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION        @SOLRINO_VERSION_MAJOR@,@SOLRINO_VERSION_MINOR@,@SOLRINO_VERSION_PATCH@,0
    PRODUCTVERSION     @SOLRINO_VERSION_MAJOR@,@SOLRINO_VERSION_MINOR@,@SOLRINO_VERSION_PATCH@,0
    FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
    FILEFLAGS          0x0L
    FILEOS             VOS__WINDOWS32
    FILETYPE           VFT_APP
    FILESUBTYPE        0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "Solrino"
            VALUE "ProductVersion",   "@SOLRINO_VERSION@"
            VALUE "CompanyName",      "Solrino"
            VALUE "FileDescription",  "Solrino chat client"
            VALUE "FileVersion",      "@SOLRINO_VERSION@"
            VALUE "Comments",         "@GIT_COMMIT@"
            VALUE "InternalName",     "Solrino"
            VALUE "OriginalFilename", "Solrino.exe"
            VALUE "LegalCopyright",   "Solrino, Chatterino and Moltorino contributors 2016-@CURRENT_YEAR@"
            VALUE "Licence",          "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
